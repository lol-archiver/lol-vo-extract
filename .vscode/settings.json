{
	"explorer.sortOrder": "modified",
	"files.eol": "\n",
	"files.insertFinalNewline": true,
	"files.trimFinalNewlines": true,
	"files.trimTrailingWhitespace": true,
	"javascript.preferences.importModuleSpecifierEnding": "js",
	"explorer.fileNesting.patterns": {
		"package.json": "pnpm-lock.yaml, tsconfig.json, eslint.config.js, .gitignore, CHANGELOG.md, README.md, LICENSE",
		"config.*.json": "config.${capture}.json.example, config.${capture}.json.example",
		"config.*.jsonc": "config.${capture}.json.example, config.${capture}.jsonc.example",
		"*.d.ts": "${capture}.d.ts.example"
	}
}
